# Copy to .env and fill in one transport. SMTP wins when both are set.
# Without either, the app falls back to showing the code in the page.

# --- SMTP through your own mailbox (no email-service account) ---
# Gmail needs an app password: Google Account > Security > App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Resend HTTP API ---
RESEND_API_KEY=
RESEND_FROM=Gambit <onboarding@resend.dev>
